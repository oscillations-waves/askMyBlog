# Copy to .env and fill in your key from https://aistudio.google.com
GEMINI_API_KEY=AIza...

# Path to your blog's content directory (default: ../shravani.roy/src/content/blog)
# BLOG_PATH=../shravani.roy/src/content/blog

# Port the server listens on (default: 7860).
# PORT=7860

# Whole request budget, including retrieval, retry waits, and generation.
# REQUEST_TIMEOUT=60s

# Override the answer model without changing the embedding model/index.
# Choose a currently supported model available to your API key.
# GEMINI_MODEL=gemini-flash-latest

# Reuse the same index between starts. In Docker this defaults to
# /data/blog.db when /data is a writable mounted volume, else /app/blog.db.
# DB_PATH=./blog.db

# Maximum time allowed for a complete CLI indexing run.
# INDEX_TIMEOUT=10m

# Comma-separated allowed CORS origins. Leave unset to allow all origins.
# In production, set this to your blog's origin to restrict access:
#   ALLOWED_ORIGIN=https://oscillations-waves.github.io
# ALLOWED_ORIGIN=
