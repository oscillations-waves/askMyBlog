# Copy to .env and fill in your key from https://aistudio.google.com
GEMINI_API_KEY=AIza...

# Path to your blog's content directory (default: ../shravani.roy/src/content/blog)
# BLOG_PATH=../shravani.roy/src/content/blog

# Port the server listens on (default: 7860).
# PORT=7860

# Comma-separated allowed CORS origins. Leave unset to allow all origins.
# In production, set this to your blog's origin to restrict access:
#   ALLOWED_ORIGIN=https://oscillations-waves.github.io
# ALLOWED_ORIGIN=
